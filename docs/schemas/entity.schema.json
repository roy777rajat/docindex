{
  "$defs": {
    "EntityType": {
      "enum": [
        "PERSON",
        "ORGANIZATION",
        "DATE",
        "MONEY",
        "EMAIL",
        "IDENTIFIER"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Where in a document a fact was seen. Locators are optional because not every format has pages or sheets.",
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_ids": {
          "description": "indexed chunks that contain this evidence",
          "items": {
            "type": "string"
          },
          "title": "Chunk Ids",
          "type": "array"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "archive_entry_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Entry Path"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EntityType"
    },
    "text": {
      "description": "as written in the document",
      "maxLength": 200,
      "title": "Text",
      "type": "string"
    },
    "normalized": {
      "description": "canonical form used for grouping",
      "maxLength": 200,
      "title": "Normalized",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "method": {
      "pattern": "^(regex|llm|manual)$",
      "title": "Method",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "entity_id",
    "type",
    "text",
    "normalized",
    "confidence",
    "method",
    "evidence"
  ],
  "title": "Entity",
  "type": "object"
}
