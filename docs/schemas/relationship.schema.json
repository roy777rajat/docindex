{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "Where in a document a fact was seen. Locators are optional because not every format has pages or sheets.",
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_ids": {
          "description": "indexed chunks that contain this evidence",
          "items": {
            "type": "string"
          },
          "title": "Chunk Ids",
          "type": "array"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "snippet": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "archive_entry_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Archive Entry Path"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RelationType": {
      "enum": [
        "ISSUED_BY",
        "BILLED_TO",
        "PAID_TO",
        "DATED_ON",
        "REFERENCES",
        "MENTIONED_WITH"
      ],
      "title": "RelationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "relationship_id": {
      "title": "Relationship Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/RelationType"
    },
    "source_entity_id": {
      "title": "Source Entity Id",
      "type": "string"
    },
    "target_entity_id": {
      "title": "Target Entity Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "method": {
      "pattern": "^(regex|llm|manual)$",
      "title": "Method",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "relationship_id",
    "type",
    "source_entity_id",
    "target_entity_id",
    "confidence",
    "method",
    "evidence"
  ],
  "title": "Relationship",
  "type": "object"
}
