# Copy to .env for LOCAL development only. Never commit a real .env. Placeholders only.
AWS_REGION=eu-west-1
# Local: use a named profile (AWS_PROFILE=cleandocs-dev). Render: set AWS keys as Render secrets.

S3_BUCKET=cleandocs-<account-id>-eu-west-1
DYNAMODB_REGISTRY_TABLE=cleandocs-registry
DYNAMODB_INGEST_TRAIL_TABLE=document-ingest-trail

SQS_INGEST_QUEUE_URL=
SQS_INGEST_DLQ_URL=

STEP_FUNCTIONS_INGESTION_ARN=
STEP_FUNCTIONS_FILE_PROCESSING_ARN=

BEDROCK_KNOWLEDGE_BASE_ID=
BEDROCK_DATA_SOURCE_ID=
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CLASSIFIER_MODEL_ID=

MAX_FILE_SIZE_MB=25
MAX_ARCHIVE_EXPANDED_SIZE_MB=100
MAX_ARCHIVE_FILE_COUNT=50
MAX_ARCHIVE_DEPTH=0

PROCESSING_MODE=SEQUENTIAL
MAX_CONCURRENT_FILES=1

TEXTRACT_MONTHLY_PAGE_CAP=300
BEDROCK_MONTHLY_TOKEN_CAP=500000

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_AUTH_SECRET=replace-me-with-a-long-random-value
